#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100
#define MOUSE 5
#define SCROLL 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    quick-tap-ms = <300>;
    flavor = "balanced";
};

/ {
    combos {
        compatible = "zmk,combos";

        tab_Right {
            bindings = <&kp LC(TAB)>;
            key-positions = <19 20>;
        };

        tab_Left {
            bindings = <&kp LS(LC(TAB))>;
            key-positions = <16 17>;
        };

        kakudai {
            bindings = <&kp LC(KP_PLUS)>;
            key-positions = <36 35>;
        };

        syukusyou {
            bindings = <&kp LC(KP_MINUS)>;
            key-positions = <22 23>;
        };

        LeftClick {
            bindings = <&mkp MB1>;
            key-positions = <17 18>;
        };

        RightClick {
            bindings = <&mkp MB2>;
            key-positions = <17 19>;
        };

        MiddleClick {
            bindings = <&mkp MB3>;
            key-positions = <17 18 19>;
        };

        kasoudesktop {
            bindings = <&kp LG(TAB)>;
            key-positions = <1 2>;
        };

        susumu {
            bindings = <&kp LA(RIGHT)>;
            key-positions = <30 31>;
        };

        modoru {
            bindings = <&kp LA(LEFT)>;
            key-positions = <29 30>;
        };

        Enter {
            bindings = <&kp ENTER>;
            key-positions = <11 12>;
        };

        Layer6seni {
            bindings = <&mo 6>;
            key-positions = <18 19>;
        };

        Del {
            bindings = <&kp DEL>;
            key-positions = <3 2>;
        };

        Tab {
            bindings = <&kp TAB>;
            key-positions = <13 12>;
        };
    };

    macros {
        Pass_Login: to_layer_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANG2 &kp LS(S) &kp LS(A) &kp S &kp N0 &kp N5 &kp N1 &kp N3 &kp N0 &kp N8 &kp RET>;
            label = "TO_LAYER_0";
        };

        Pass_Remote_Login: Pass_Remote_Login {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANG2 &kp LS(G) &kp B &kp N0 &kp N5 &kp N1 &kp N3 &kp N0 &kp N8 &kp RET>;
            label = "PASS_REMOTE_LOGIN";
        };

        Pass_Pascal: Pass_Pascal {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANG2 &kp N1 &kp N2 &kp N1 &kp N0 &kp N0 &kp N2 &kp TAB &kp N0 &kp N1 &kp N1 &kp N1 &kp N7 &kp N0 &kp N3 &kp N0 &kp TAB &kp N0 &kp N1 &kp N1 &kp N1 &kp N7 &kp N0 &kp N3 &kp N0 &kp RET>;
            label = "PASS_PASCAL";
        };

        Pass_Expart: Pass_Expart {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANG2 &kp U &kp S &kp E &kp R &kp N2 &kp N4 &kp TAB &kp LS(Z) &kp LS(T) &kp LS(G) &kp LS(E) &kp LS(N) &kp LS(P) &kp LS(S) &kp LS(Y) &kp ENTER>;
            label = "PASS_EXPART";
        };

        Pass_43zei: Pass_43zei {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANG2 &kp N4 &kp N3 &kp Z &kp E &kp I &kp AT &kp RET>;
            label = "PASS_43ZEI";
        };

        Pass_toukiTS078: Pass_toukiTS078 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANG2 &kp T &kp O &kp U &kp K &kp I &kp LS(T) &kp LS(S) &kp N0 &kp N7 &kp N8 &kp RET>;
            label = "PASS_TOUKITS078";
        };

        Pass_touki_renkeisystem: Pass_touki_renkeisystem {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANG2 &kp LS(E) &kp LS(A) &kp N9 &kp N9 &kp N5 &kp N8 &kp N5 &kp TAB &kp S &kp MINUS &kp N0 &kp N1 &kp N1 &kp N1 &kp N7 &kp N0 &kp N3 &kp N0 &kp N1 &kp N1 &kp N0 &kp N5 &kp RET>;
            label = "PASS_TOUKI_RENKEISYSTEM";
        };

        Pass_gaiyousyo: Pass_gaiyousyo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANG2 &kp T &kp O &kp U &kp B &kp U &kp N0 &kp N1 &kp TAB &kp T &kp O &kp U &kp B &kp U &kp N0 &kp N1 &kp RET>;
            label = "PASS_GAIYOUSYO";
        };

        Pass_zeimusystem_syokai: Pass_zeimusystem {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANG2 &kp N0 &kp N1 &kp N1 &kp N1 &kp N7 &kp N0 &kp N3 &kp N0 &kp TAB &kp N0 &kp N1 &kp N1 &kp N1 &kp N7 &kp N0 &kp N3 &kp N0 &kp RET>;
            label = "PASS_ZEIMUSYSTEM";
        };

        Pass_zeimusystem_2: Pass_zeimusystem_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANG2 &kp N0 &kp N1 &kp N1 &kp N1 &kp N7 &kp N0 &kp N3 &kp N0 &kp RET>;
            label = "PASS_ZEIMUSYSTEM_2";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&Pass_Login>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        scroll_up_down: mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        scroll_right_left: mouse_wheel_right_left {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&mt LG(L) Q  &mt LC(W) W   &mt LG(E) E   &kp R             &mt LC(T) T                                        &mt LC(Y) Y          &mt LC(U) U  &mt LC(Q) I      &mt LA(GRAVE) O    &mt LC(P) P
&mt LALT A   &mt LC(S) S   &kp D         &mt LC(F) F       &mt LC(LG(LEFT)) G                  &bt BT_SEL 0   &mt LC(LG(RIGHT)) H  &kp J        &kp K            &mt LC(LA(DEL)) L  &mt LS(GRAVE) MINUS
&mt LC(Z) Z  &mt LC(X) X   &mt LC(C) C   &mt LC(V) V       &kp B               &bt BT_SEL 2    &bt BT_SEL 1   &kp N                &mt LC(W) M  &mt LC(T) COMMA  &mt LS(MINUS) DOT  &mt LS(SLASH) SLASH
&kp LCTRL    &kp LEFT_WIN  &kp LEFT_ALT  &mt LSHIFT LANG2  &lt 1 LANG1         &kp SPACE       &kp BACKSPACE  &lt 2 ENTER                                                           &kp LEFT_CONTROL
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_1 {
            bindings = <
&mt F2 F1                    &mt F4 F3          &kp UP      &mt F5 F6   &mt F8 F7                                         &kp KP_ASTERISK       &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp LS(KP_DIVIDE)
&mt ESC SPACE                &kp LEFT           &kp DOWN    &kp RIGHT   &mt F9 F10                     &kp LS(SEMICOLON)  &kp LS(SINGLE_QUOTE)  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_MINUS
&mt LEFT_SHIFT LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LS(N9)  &kp LS(N0)  &mt F12 F11  &kp KP_NUMLOCK    &kp LS(EQUAL)      &kp EQUAL             &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PIPE
&trans                       &trans             &trans      &trans      &trans       &trans            &kp BACKSPACE      &kp KP_NUMBER_0                                                          &kp RIGHT_SHIFT
            >;

            sensor-bindings = <&scroll_right_left>;
        };

        layer_2 {
            bindings = <
&bt BT_CLR_ALL  &kp AT_SIGN       &kp POUND    &kp DOLLAR      &kp PERCENT                                            &Pass_Pascal     &kp LS(NUMBER_7)  &kp LS(N8)        &kp LS(N9)        &kp LS(N0)
&kp GRAVE       &Pass_toukiTS078  &Pass_43zei  &studio_unlock  &trans                       &Pass_zeimusystem_syokai  &Pass_Login      &kp LS(NUMBER_4)  &kp LS(N5)        &kp LS(NUMBER_6)  &Pass_Expart
&kp F1          &kp F2            &kp F3       &kp F4          &kp F5       &bt BT_SEL 3    &Pass_zeimusystem_2       &Pass_gaiyousyo  &kp LS(NUMBER_1)  &kp LS(NUMBER_2)  &kp LS(NUMBER_3)  &Pass_touki_renkeisystem
&trans          &trans            &trans       &trans          &trans       &bt BT_SEL 4    &trans                    &trans                                                                 &Pass_Remote_Login
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_3 {
            bindings = <
&trans  &kp LC(LS(TAB))     &kp PRINTSCREEN         &kp LC(TAB)              &trans                                     &trans  &kp HOME        &kp UP_ARROW    &kp END          &trans
&trans  &kp LG(LEFT_ARROW)  &kp LG(RIGHT_ARROW)     &kp LC(LG(LEFT_ARROW))   &kp LC(LG(RIGHT_ARROW))            &trans  &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans
&trans  &kp LEFT_SHIFT      &kp LG(LS(LEFT_ARROW))  &kp LG(LS(RIGHT_ARROW))  &trans                   &trans    &trans  &trans  &kp DELETE      &kp PAGE_UP     &kp PAGE_DOWN    &trans
&trans  &trans              &trans                  &trans                   &trans                   &trans    &trans  &trans                                                   &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                         &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans            &trans       &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans    &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans    &trans       &trans                                                  &bt BT_CLR_ALL
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        MOUSE {
            bindings = <
&trans  &trans    &trans    &trans    &trans                    &trans  &trans    &trans    &trans    &trans
&trans  &mkp MB3  &mkp MB2  &mkp MB1  &trans            &trans  &trans  &mkp MB1  &mkp MB2  &mkp MB3  &trans
&trans  &trans    &trans    &trans    &trans  &trans    &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans    &trans    &trans    &trans  &trans    &trans  &trans                                &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };
    };
};
